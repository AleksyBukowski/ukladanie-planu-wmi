# Skopiuj do .env i dostosuj:  cp .env.example .env
# Wszystkie wartości mają rozsądne domyślne – .env jest potrzebny tylko, gdy chcesz coś zmienić.

# --- PostgreSQL ---
POSTGRES_DB=plan
POSTGRES_USER=plan
POSTGRES_PASSWORD=plan
# Port bazy wystawiony na hosta (np. dla DBeaver / pgAdmin)
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# Środowisko: development | production (w trybie dev docker-compose.override.yml ustawia development)
ENVIRONMENT=production
# Port backendu na hoście (Swagger UI: http://localhost:8000/api/docs)
BACKEND_PORT=8000
# Klucz do podpisywania tokenów logowania – na serwerze OBOWIĄZKOWO zmienić!
SECRET_KEY=change-me-in-production

# --- Mock USOS ---
# Adres zamockowanego USOS widziany z backendu (wewnątrz sieci Dockera)
USOS_BASE_URL=http://mock-usos:8001
MOCK_USOS_PORT=8001

# --- Frontend ---
# Dev: serwer Vite (http://localhost:5173)
FRONTEND_PORT=5173
# Serwer/produkcja: nginx z gotowym buildem (http://localhost:8080) – tu kieruje reverse proxy HTTPS
HTTP_PORT=8080
